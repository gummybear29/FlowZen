<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#222831"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/what_can_I_help_ID"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="What can I help with?"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="40sp" />

    <!-- Search Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_bg"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/textual_search_bar_ID"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="ASK ANYTHING"
            android:textColorHint="#888888"
            android:background="@android:color/white"
            android:padding="10dp"
            android:textColor="#000000" />

        <ImageButton
            android:id="@+id/send_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/plane"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Send text input"
            android:scaleType="fitCenter"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:gravity="center_horizontal">

        <ImageButton
            android:id="@+id/mic_button"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/microphone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice input"
            android:scaleType="fitCenter"
            android:layout_margin="10dp"
            android:padding="4dp" />

        <ImageButton
            android:id="@+id/gallery_button"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/gallery"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Image input"
            android:scaleType="fitCenter"
            android:layout_margin="10dp"
            android:padding="4dp" />
    </LinearLayout>
    <ImageView
        android:id="@+id/selected_image"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center_horizontal"
        android:scaleType="centerCrop"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="57dp"
        android:layout_height="37dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Prediction Result -->
    <TextView
        android:id="@+id/prediction_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Prediction will appear here"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:paddingTop="20dp"
        android:textAlignment="center" />
</LinearLayout>
